# ── Supabase ────────────────────────────────────────────────────────────────
# หาได้จาก Supabase Dashboard → Project Settings → Data API
#   Project URL  → VITE_SUPABASE_URL
#   anon public  → VITE_SUPABASE_ANON_KEY
#
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local ถูก gitignore ไว้แล้ว)
#   PowerShell:  Copy-Item .env.example .env.local

# ใส่แค่ Project URL เท่านั้น ห้ามต่อ /rest/v1 ต่อท้าย
# supabase-js เติม path ให้เองตาม service ที่เรียก (/rest/v1, /auth/v1, /realtime/v1)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxx

# ── สำคัญมาก ────────────────────────────────────────────────────────────────
# ห้ามใส่ service_role key ในไฟล์นี้เด็ดขาด
# ทุกตัวแปรที่ขึ้นต้นด้วย VITE_ จะถูก bundle ลงไปใน JS ที่ส่งให้ browser
# แปลว่าลูกค้าทุกคนที่สแกน QR จะอ่านค่านั้นได้ → service_role = เปิดฐานข้อมูลทั้งใบ
# ความปลอดภัยของระบบนี้ต้องมาจาก RLS Policy บน Supabase เท่านั้น
